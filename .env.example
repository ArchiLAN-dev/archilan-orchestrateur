# Required
API_KEY=change_me
BRIDGE_TOKEN=shared_internal_token_for_bridge_instances

# HTTP
PORT=8000

# Port pool allocated to Bridge containers
PORT_RANGE_START=25000
PORT_RANGE_END=25099

# SQLite database path (inside the /data volume)
DB_PATH=/data/orchestrateur.db

# Docker
DOCKER_HOST=unix:///var/run/docker.sock
BRIDGE_IMAGE=archilan-bridge:latest
BRIDGE_NETWORK=archilan_default

# Exposition du serveur Archipelago (epic 37)
#
# En production, le reverse proxy est la seule socket publique d'une run : il termine le TLS et
# joint le conteneur par son nom sur le réseau ci-dessous. Le port n'est alors plus publié sur
# l'hôte, et le trafic joueur cesse de circuler en clair.
#
#   AP_PUBLISH_HOST_PORT=false
#   PROXY_NETWORK=archilan-proxy
#
# En développement local il n'y a pas de proxy : on garde la publication sur l'hôte, sinon aucun
# client ne peut se connecter. Les deux à la fois (pas de publication et pas de réseau proxy) sont
# refusés au démarrage - toutes les runs seraient injoignables sans le moindre symptôme.
AP_PUBLISH_HOST_PORT=true
PROXY_NETWORK=

# Publication du port REST du bridge (story 37.7)
#
# L'API joignait le bridge par l'adresse publique du serveur, pour un conteneur tournant sur la
# meme machine. Depuis la version 0.14.2 de l'API, elle le joint par son nom de conteneur sur le
# reseau partage : le port n'a plus besoin d'etre publie, et la derniere socket publique d'une run
# se ferme.
#
# En production : false. En local, ou l'API peut tourner hors conteneur : true.
# A ne basculer qu'APRES avoir verifie que l'API n'a plus besoin du port hote - sinon elle perd
# l'acces a tous les bridges, donc la generation et le suivi des runs.
BRIDGE_PUBLISH_HOST_PORT=true

# Webhook to API Symfony (optional)
WEBHOOK_URL=http://api/internal/orchestrateur/webhook
WEBHOOK_SECRET=change_me

# CORS - origins autorisées (séparées par virgule). * = tout autoriser (dev uniquement)
# Exemple prod : CORS_ORIGINS=https://archilan.fr,https://api.archilan.fr
CORS_ORIGINS=*

# Minio (S3) - fichiers apworld et yamls de session
# Laisser MINIO_ENDPOINT vide pour désactiver (les fichiers ne seront pas pré-chargés dans le container)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false
MINIO_BUCKET_APWORLDS=apworlds
MINIO_BUCKET_SESSIONS=sessions
